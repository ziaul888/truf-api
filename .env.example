NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Added as features land:
# Postgres — local: `docker compose up -d`
DATABASE_URL=postgresql://turf:turf@localhost:5432/turf_dev
# Uploaded ground photos are stored here and served at /api/v1/uploads
UPLOAD_DIR=uploads

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=8

# First admin, created by `yarn db:seed` (password: 12+ characters)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# EMAIL_FROM=bookings@yourdomain.com
# Customer sign-in by SMS code (Twilio Verify). Unset: codes are logged (dev only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# CUSTOMER_SESSION_DAYS=30
# Testing only (refused in production): every sign-in code is this, no SMS sent
# TEST_OTP_CODE=13456
# Optional dedicated live test customer (also supported in production). Set BOTH to enable.
# Use a dedicated test number in E.164 format and an 8–10 digit secret code. Keep the code server-side.
# LIVE_TEST_PHONE=+8801799009901
# LIVE_TEST_OTP=
# The customer site, used in Stripe return URLs and email links
PUBLIC_APP_URL=http://localhost:3000
CURRENCY=bdt

# Venue timezone (IANA). Slot dates/hours and "today" use it.
VENUE_TIMEZONE=Asia/Dhaka

# Keep false through the backend rollout. After ALL old instances stop, run
# yarn db:reconcile:booking-slots, then set true on every new API instance.
MULTI_SLOT_BOOKINGS_ENABLED=false
