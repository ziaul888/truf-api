// Turf API — v1 schema. Change it, then run `yarn db:migrate` (never edit the DB by hand).
// Money is stored as integers in the currency's smallest unit (e.g. 1500 = 15.00).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
}

enum SlotStatus {
  available
  /// Reserved for a portal checkout until heldUntil; then booked or released.
  held
  booked
  blocked
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  /// Confirmed and the slot has ended (set by an hourly job).
  completed
  /// The team didn't turn up (staff, once the slot started): the advance stays, the rest of the due is written off.
  no_show
}

/// A repeat booking: `active` keeps booking (ongoing series), `stopped` was turned off by staff.
enum BookingSeriesStatus {
  active
  stopped
}

enum BookingSource {
  portal
  staff
}

/// The booking's overall payment state, recomputed from its payments.
enum BookingPaymentStatus {
  unpaid
  partial
  paid
  refunded
  failed
}

enum PaymentMethod {
  card
  cash
  bank_transfer
  /// Sent by the customer to the venue's bKash / Nagad number; staff verify it by hand.
  bkash
  nagad
}

enum BookingEventType {
  created
  payment_received
  confirmed
  cancelled
  refunded
  email_sent
  completed
  /// The customer asked to cancel while their bKash / Nagad payment was being verified.
  cancel_requested
  /// Staff marked the booking no-show.
  no_show
}

/// Why staff blocked a slot (the dashboard's block form list).
enum BlockReason {
  maintenance
  reserved
  event
  weather
  other
}

enum SlotEventAction {
  block
  unblock
  /// A venue closure blocked the slot / lifting it freed the slot.
  close
  reopen
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum Sport {
  football
  cricket
  badminton
  tennis
  hockey
  basketball
  other
}

/// Which days a ground takes bookings. `custom` uses Ground.customDays.
enum AvailableDays {
  everyday
  weekdays
  weekends
  custom
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Dashboard staff. Customers never log in in v1.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(manager)
  isActive     Boolean  @default(true)
  /// Embedded in every JWT. Bumping it (logout, password change) invalidates all of the user's tokens.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blockedSlots      Slot[]
  slotEvents        SlotEvent[]
  bookingsCreated   Booking[]      @relation("BookingCreatedBy")
  bookingsCancelled Booking[]      @relation("BookingCancelledBy")
  paymentsRecorded  Payment[]
  bookingEvents     BookingEvent[]
  closuresCreated Closure[] @relation("ClosureCreatedBy")
  closuresLifted  Closure[] @relation("ClosureLiftedBy")
  settingsEvents  SettingsEvent[]
  seriesCreated   BookingSeries[] @relation("BookingSeriesCreatedBy")
  seriesStopped   BookingSeries[] @relation("BookingSeriesStoppedBy")
}

model Ground {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Plain text shown to customers on the ground page and at checkout.
  rules       String?
  address     String?
  /// https link to the ground on a map (e.g. Google Maps). Null falls back to the venue's map link.
  mapUrl      String?
  /// Hourly price, smallest currency unit. The off-peak price when peakPrice is set.
  hourlyPrice Int
  /// Whole hours, 0–23. Slots run from openingHour up to closingHour.
  openingHour Int
  /// Whole hours, 1–24, greater than openingHour.
  closingHour Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sport         Sport         @default(other)
  /// `4x4` … `9x9`, `11x11`, `net`, `court` — validated by the API (not valid Prisma enum names).
  format        String?
  /// `outdoor-turf`, `indoor-court`, `covered-net` — validated by the API.
  surface       String?
  /// Free text, e.g. "28×18 m".
  dimensions    String?
  /// Players.
  capacity      Int?
  /// Labels from a fixed list (see grounds.schemas.ts).
  amenities     String[]      @default([])
  availableDays AvailableDays @default(everyday)
  /// Only used when availableDays = custom; otherwise always empty.
  customDays    Weekday[]     @default([])
  /// Inactive grounds are hidden from the portal regardless.
  showOnPortal  Boolean       @default(true)
  /// Staff only — never returned by public endpoints.
  internalNotes String?

  /// Hourly price inside peakRanges, smallest currency unit. Set together with peakRanges.
  peakPrice           Int?
  /// `[{ fromHour, toHour }]`, inside opening hours, no overlaps — validated by the API.
  peakRanges          Json     @default("[]")
  /// 60, 90 or 120. Slots start at openingHour in steps of this length; a trailing partial slot is dropped.
  slotDurationMinutes Int      @default(60)
  /// Stored file names, in display order (first = cover). Files live in UPLOAD_DIR/grounds/<id>/.
  photos              String[] @default([])

  slots      Slot[]
  bookings   Booking[]
  slotEvents SlotEvent[]
  series     BookingSeries[]

  @@index([sport])
}

/// One bookable slot on one ground, in venue-local time (VENUE_TIMEZONE). `status` is the source of truth for availability.
model Slot {
  id              String       @id @default(uuid())
  groundId        String
  /// Venue-local calendar date.
  date            DateTime     @db.Date
  /// Start hour, 0–23. The slot starts at startHour:startMinute and covers durationMinutes.
  startHour       Int
  /// 0 or 30 (validated by the API): 90-minute slots can start on the half hour.
  startMinute     Int          @default(0)
  /// 60, 90 or 120 — copied from the ground when the slot was created.
  durationMinutes Int          @default(60)
  /// slotPrice() at creation, smallest currency unit. Later price changes don't touch existing bookings.
  price           Int
  status          SlotStatus   @default(available)
  /// The current block; null unless status = blocked. History lives in SlotEvent.
  blockReason     BlockReason?
  blockNote       String?
  blockedById     String?
  blockedAt       DateTime?
  /// Set when a venue closure made the block, so lifting the closure frees only its own blocks.
  closureId       String?
  /// While status = held: when the hold lapses, and the pending booking holding it.
  heldUntil       DateTime?
  heldByBookingId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ground    Ground      @relation(fields: [groundId], references: [id], onDelete: Restrict)
  blockedBy User?       @relation(fields: [blockedById], references: [id], onDelete: SetNull)
  closure   Closure?    @relation(fields: [closureId], references: [id], onDelete: SetNull)
  bookings  Booking[]
  events    SlotEvent[]

  @@unique([groundId, date, startHour, startMinute])
  @@index([closureId])
  @@index([heldUntil])
  @@index([groundId])
  @@index([date])
  @@index([status])
}

/// Audit log of every block and unblock. Keeps the slot's ground, date and hour so history
/// survives when a free slot is regenerated.
model SlotEvent {
  id        String          @id @default(uuid())
  slotId    String?
  groundId  String
  date      DateTime        @db.Date
  startHour Int
  action    SlotEventAction
  reason    BlockReason?
  note      String?
  userId    String?
  createdAt DateTime        @default(now())

  slot   Slot?  @relation(fields: [slotId], references: [id], onDelete: SetNull)
  ground Ground @relation(fields: [groundId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slotId])
  @@index([groundId, date])
  @@index([createdAt])
}

/// Closes some or all grounds for a date range (Eid, a power cut). Stored, so slots generated
/// later on those days are created already blocked. Lifting sets liftedAt; rows are never deleted.
model Closure {
  id          String      @id @default(uuid())
  fromDate    DateTime    @db.Date
  toDate      DateTime    @db.Date
  /// Empty = every ground, including grounds added later.
  groundIds   String[]    @default([])
  reason      BlockReason
  /// Staff only.
  note        String?
  /// Shown to customers, e.g. "Closed for Eid".
  publicLabel String?
  createdById String?
  createdAt   DateTime    @default(now())
  liftedAt    DateTime?
  liftedById  String?

  createdBy User?  @relation("ClosureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy  User?  @relation("ClosureLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)
  slots     Slot[]

  @@index([fromDate, toDate])
}

/// Venue-wide slot settings. A single row with id = 1; defaults apply until it is saved.
model SlotSettings {
  id                      Int      @id @default(1)
  /// How far ahead customers can book, and how far the auto-generate job creates slots.
  advanceBookingDays      Int      @default(30)
  autoGenerate            Boolean  @default(true)
  /// Customers can't book or cancel a slot that starts within this many hours.
  cancellationCutoffHours Int      @default(2)
  notifyCustomerOnBlock   Boolean  @default(true)
  notifyAdminOnBooking    Boolean  @default(false)
  /// How long a portal checkout holds its slot before it is released.
  holdMinutes             Int      @default(15)
  /// Added to portal bookings, smallest currency unit; stored on each booking.
  serviceFee              Int      @default(5000)
  /// Lets portal customers choose "pay cash at the venue" instead of card.
  portalCashEnabled       Boolean  @default(true)
  /// Card on the portal; also needs the Stripe keys. Off hides it even with them.
  portalCardEnabled       Boolean  @default(true)
  /// bKash / Nagad on the portal; also needs that number. Off hides it and keeps the number.
  portalBkashEnabled      Boolean  @default(true)
  portalNagadEnabled      Boolean  @default(true)
  /// The venue's bKash / Nagad number customers send money to. Null = not offered on the portal.
  bkashNumber             String?
  nagadNumber             String?
  updatedAt               DateTime @updatedAt
}

model Customer {
  id               String    @id @default(uuid())
  name             String
  /// Optional: without one, no customer emails are sent. Phone is the identity key.
  email            String?
  /// Normalised, e.g. "+8801711000000" — the lookup key for staff and checkout.
  phone            String?   @unique
  stripeCustomerId String?   @unique
  /// Staff only.
  adminNote        String?
  /// Bumped on sign-out, revoking every customer_token issued before.
  sessionVersion   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  bookings Booking[]
  series   BookingSeries[]

  @@index([email])
}

/// A slot can have several bookings over time (e.g. cancelled, then rebooked), but at most one
/// live one: `liveSlotId` equals slotId while the booking is pending, confirmed or completed,
/// and is cleared on cancel — its unique index is the database-level double-booking guard.
model Booking {
  id                      String               @id @default(uuid())
  /// Short and human-readable, e.g. CT-24A7F. Shown to customers.
  bookingNumber           String               @unique
  source                  BookingSource
  groundId                String
  slotId                  String
  liveSlotId              String?              @unique
  customerId              String
  /// Contact details given for this booking (portal checkout never overwrites the customer record).
  contactName             String
  /// Null: no customer emails for this booking.
  contactEmail            String?
  contactPhone            String
  status                  BookingStatus        @default(pending)
  paymentStatus           BookingPaymentStatus @default(unpaid)
  /// Slot price at booking time, smallest currency unit.
  amount                  Int
  /// Portal service fee at booking time; 0 for staff bookings.
  serviceFee              Int                  @default(0)
  /// amount + serviceFee.
  total                   Int
  /// Partial payments (staff bookings only).
  dueDate                 DateTime?            @db.Date
  dueNote                 String?
  dueReminderSentAt       DateTime?
  /// Staff only.
  notes                   String?
  stripeCheckoutSessionId String?              @unique
  /// Portal customer chose to pay cash at the venue: pending until staff confirm.
  payAtVenue              Boolean              @default(false)
  createdById             String?
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  cancelReason            String?
  cancelledById           String?
  /// The customer asked to cancel while their bKash / Nagad payment was under review; staff decide.
  cancelRequestedAt       DateTime?
  /// Made by a repeat booking (BookingSeries); otherwise null.
  seriesId                String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?

  ground      Ground         @relation(fields: [groundId], references: [id], onDelete: Restrict)
  slot        Slot           @relation(fields: [slotId], references: [id], onDelete: Restrict)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User?          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?          @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  series      BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  payments    Payment[]
  events      BookingEvent[]

  @@index([groundId])
  @@index([slotId])
  @@index([customerId])
  @@index([seriesId])
  @@index([status])
  @@index([createdAt])
}

/// A repeat booking made by staff: one ground, one start hour, chosen weekdays. Each matching
/// date with a free slot gets its own normal Booking (seriesId set). Fixed: fromDate–untilDate,
/// all booked at creation. Ongoing (untilDate null): booked up to the slots that exist, then the
/// hourly slot job keeps booking new dates until staff stop it. Busy dates are skipped, never retried.
model BookingSeries {
  id            String              @id @default(uuid())
  groundId      String
  customerId    String
  contactName   String
  contactPhone  String
  /// Null: none given and none stored. Series bookings never email the customer.
  contactEmail  String?
  /// 0–23, with startMinute: the slot that starts at startHour:startMinute is booked on each date.
  startHour     Int
  /// 0 or 30 (validated by the API).
  startMinute   Int                 @default(0)
  /// `mon` … `sun` (WEEKDAYS in grounds.schemas.ts), validated by the API.
  weekdays      String[]
  fromDate      DateTime            @db.Date
  /// Null = ongoing.
  untilDate     DateTime?           @db.Date
  status        BookingSeriesStatus @default(active)
  /// The last date considered (booked or skipped): the hourly job continues from the day after.
  bookedThrough DateTime?           @db.Date
  /// Staff only.
  notes         String?
  createdById   String?
  stoppedAt     DateTime?
  stoppedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  ground    Ground              @relation(fields: [groundId], references: [id], onDelete: Restrict)
  customer  Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("BookingSeriesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  stoppedBy User?               @relation("BookingSeriesStoppedBy", fields: [stoppedById], references: [id], onDelete: SetNull)
  bookings  Booking[]
  skips     BookingSeriesSkip[]

  @@index([groundId])
  @@index([customerId])
  @@index([status])
}

/// A date a series could not book (slot taken, blocked, held, closed day, ended, or no slot). Never retried.
model BookingSeriesSkip {
  id        String   @id @default(uuid())
  seriesId  String
  date      DateTime @db.Date
  /// 'booked' | 'blocked' | 'held' | 'closed' | 'ended' | 'no_slot'
  reason    String
  createdAt DateTime @default(now())

  series BookingSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([seriesId, date])
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String
  method                PaymentMethod
  /// Card payments only.
  stripePaymentIntentId String?       @unique
  cardLast4             String?
  amount                Int
  /// ISO 4217, lowercase as Stripe uses it (e.g. "bdt").
  currency              String
  status                PaymentStatus @default(pending)
  /// When the money counted as received (succeeded): reports and the dashboard date revenue by this.
  /// A bKash / Nagad payment is received when staff verify it. Null on older rows: use createdAt.
  receivedAt            DateTime?
  stripeRefundId        String?       @unique
  refundedAt            DateTime?
  /// bKash / Nagad transaction id (TrxID), uppercase. Unique per method among payments that are not
  /// failed or deleted: a partial unique index "Payment_method_reference_key", hand-written in the
  /// 20261106150000_wallet_payment_fixes migration (Prisma can't express it). A rejected TrxID can be reused.
  reference             String?
  /// bKash / Nagad: the number the customer sent the money from (portal payments).
  payerNumber           String?
  note                  String?
  recordedById          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

/// The booking detail page's activity timeline.
model BookingEvent {
  id        String           @id @default(uuid())
  bookingId String
  type      BookingEventType
  detail    String?
  userId    String?
  createdAt DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

/// One JSON document per settings section ("venue", "website", "notifications"), validated by its
/// Zod schema on read and write. Slot settings keep their own typed table (SlotSettings).
model SettingsSection {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Who changed which settings fields, and when (field names only, never values).
model SettingsEvent {
  id        String   @id @default(uuid())
  /// "venue", "website", "notifications", "slots"
  section   String
  fields    String[]
  /// "update", "upload", "reset"
  action    String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([section, createdAt])
}

/// Small internal state the app keeps between restarts (last Stripe webhook, last due digest).
/// Not settings: never shown in a form or reset.
model SystemState {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Every email the app tried to send, for the Notifications page's log.
model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  /// e.g. "booking_confirmed", "staff_new_booking", "test"
  kind      String
  ok        Boolean
  error     String?
  bookingId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
